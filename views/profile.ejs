<!DOCTYPE html>
<html lang="ja">
<head>
    <title>プロフィール設定 / X-Board</title>
    <%- include('partials/header') %>
</head>
<body>
<div class="container">
    <%- include('partials/sidebar') %>
    <main>
        <div class="header-title">プロフィール設定</div>
        <div style="padding: 20px;">
            <div style="display:flex; align-items:center; gap:20px; margin-bottom:25px;">
                <img id="profImg" class="avatar" style="width:70px; height:70px;" src="" alt="Avatar">
                <div>
                    <h2 id="profDisplay" style="margin:0; font-size:22px;"></h2>
                    <span id="profUser" style="color:var(--text-muted);"></span>
                </div>
            </div>
            
            <div style="margin-bottom:15px;">
                <label style="font-weight:bold; font-size:14px; color:var(--text-muted);">表示名</label>
                <input type="text" id="editDisplay" class="input-field" style="margin-top:5px;">
            </div>
            
            <div style="margin-bottom:25px;">
                <label style="font-weight:bold; font-size:14px; color:var(--text-muted);">プロフィール画像 URL</label>
                <input type="text" id="editAvatar" class="input-field" style="margin-top:5px;">
            </div>
            
            <button id="saveProfile" class="tweet-btn" style="width:100%;">設定を保存</button>
        </div>
    </main>
</div>
<script src="/js/app.js"></script>
</body>
</html>
